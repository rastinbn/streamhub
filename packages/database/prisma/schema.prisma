// StreamHub - Initial Prisma schema
// Phase 1: structural foundation only. Relationships and business rules
// (constraints, cascades, indexes beyond the obvious, etc.) will be refined
// in later phases as each domain module is implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  avatar       String?
  bio          String?
  role         Role     @default(USER)
  emailVerified Boolean @default(false)
  // Phase 10 — Moderation. Set by the admin/moderation ban endpoint; a
  // banned user cannot log in (enforced in AuthService.login) and their
  // refresh tokens are revoked at ban time. `banReason` is an internal
  // moderator note — stripped from every public user payload.
  bannedAt     DateTime?
  banReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel   Channel?
  follows   Follow[]       @relation("FollowerUser")
  messages  ChatMessage[]
  notifications Notification[]
  emailVerificationTokens EmailVerificationToken[]
  submittedReports Report[] @relation("SubmittedReports")

  @@map("users")
}

// Single-use tokens emailed to a user to confirm ownership of their email
// address. Only the SHA-256 digest of the token is stored (mirrors
// Stream.streamKeyHash) so a leaked database dump can't be used to verify
// arbitrary accounts. Rows are consumed (consumedAt set) or left to expire.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum Role {
  USER
  STREAMER
  MODERATOR
  ADMIN
}

model Channel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  avatar         String?
  banner         String?
  category       String?
  followersCount Int      @default(0)
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id])
  // Phase 10 — Moderation. A suspended channel cannot create streams, the
  // MediaMTX publish webhook denies its stream keys, and any live broadcast
  // is force-ended at suspension time.
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  streams      Stream[]
  followers    Follow[]      @relation("FollowedChannel")
  chatMessages ChatMessage[]
  layout       StreamPageLayout?

  @@index([category])
  @@index([name])
  @@map("channels")
}

// Customizable Stream Page — one row per channel (unique `channelId`)
// holding BOTH the published document (`layout`) and the working draft
// (`draftLayout`), so saving a draft never touches what the public page
// serves. Both are versioned JSON documents validated by the layouts module
// before persistence (see docs/stream-page-layout.md). `layout` is null
// until the first publish — the public page falls back to the default.
model StreamPageLayout {
  id          String   @id @default(cuid())
  channelId   String   @unique
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  layout      Json?
  draftLayout Json?
  hasPublished Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stream_page_layouts")
}

model Stream {
  id            String       @id @default(cuid())
  channelId     String
  channel       Channel      @relation(fields: [channelId], references: [id])
  title         String?
  description   String?
  category      String?
  thumbnail     String?
  // SHA-256 digest of the raw stream key. The raw key is high-entropy
  // (crypto.randomBytes) and returned to the owner exactly once (on
  // creation/rotation); only this deterministic digest is persisted so the
  // MediaMTX publish webhook can look a presented key up in O(1) without
  // ever storing (or being able to reconstruct) the secret itself. Null
  // once revoked — a revoked stream cannot authenticate a publish until
  // rotated again.
  streamKeyHash String?      @unique
  // Plaintext copy of the raw stream key used purely to build the public HLS
  // playback URL (`http://<hls-host>:8888/<playbackPath>/index.m3u8`). It is
  // the same opaque path OBS publishes to, so it is only ever exposed to
  // clients for LIVE streams; non-live rows never serialize it.
  playbackPath String?       @unique
  status        StreamStatus @default(OFFLINE)
  startedAt     DateTime?
  endedAt       DateTime?
  // Denormalized live viewer count. Updated by the analytics flush pipeline
  // (Phase 8) at each aggregation tick — never per viewer heartbeat, which
  // touches Redis only — so a page refresh / status poll is never more than
  // one flush interval (30s) stale.
  viewerCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  analytics      StreamAnalytics?
  viewerMetrics  ViewerMetric[]
  vods           Vod[]

  @@index([channelId])
  @@index([status])
  @@index([category])
  @@index([title])
  @@map("streams")
}

// Phase 8 — Analytics. See docs/analytics.md for the full architecture.
//
// Per-stream aggregate row, created when a broadcast goes LIVE and updated
// by the analytics flush pipeline (every ~30s while live, and once more on
// unpublish). Read endpoints never compute aggregates from raw samples —
// they sum these pre-aggregated rows, which keeps the analytics queries
// bounded regardless of stream count. `channelId`/`startedAt`/`endedAt` are
// denormalized copies of `Stream` fields so channel-scoped queries
// (overview, per-stream lists) hit a single small table with its own index
// instead of joining through `streams`.
model StreamAnalytics {
  id               String   @id @default(cuid())
  streamId         String   @unique
  stream           Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  channelId        String
  startedAt        DateTime
  endedAt          DateTime?
  durationSeconds  Int      @default(0)
  watchTimeSeconds Int      @default(0)
  totalViews       Int      @default(0)
  peakViewers      Int      @default(0)
  // Weighted by watch time: watchTimeSeconds / durationSeconds. Float so
  // non-integer averages (e.g. 7.5 concurrent viewers) survive persistence.
  averageViewers   Float    @default(0)
  followersGained  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([channelId, startedAt])
  @@map("stream_analytics")
}

// Phase 8 — Analytics. One row per stream per aggregation tick (the flush
// pipeline samples the live Redis presence set ~every 30s, NOT per
// heartbeat). Rows power the per-stream "viewers over time" timeline and
// the watch-time accumulation that yields average viewers. Bounded per
// stream: a 24h broadcast at a 30s flush rate produces ~2.9k rows, and rows
// are only ever read for one stream at a time.
model ViewerMetric {
  id        String   @id @default(cuid())
  streamId  String
  stream    Stream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  channelId String
  viewers   Int
  sampledAt DateTime @default(now())

  @@index([streamId, sampledAt])
  @@index([channelId, sampledAt])
  @@map("viewer_metrics")
}

enum StreamStatus {
  OFFLINE
  LIVE
  ENDED
}

// Phase 9 — VOD & Content. PUBLIC videos appear in browse/search;
// UNLISTED are reachable by link but omitted from lists; PRIVATE only for
// the owner (and admins). See docs/storage.md.
enum VodVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

// Phase 9 — VOD & Content. Metadata-only table: the video binary lives in
// object storage (local disk in dev, S3-compatible in prod) and is
// referenced by `storageKey` — see docs/storage.md for the abstraction.
// One VOD per finished broadcast; created by the MediaMTX recording
// webhook, never written by user-facing API routes.
model Vod {
  id          String        @id @default(cuid())
  // Nullable: the source stream row can be hard-deleted (admin panel) while
  // the recording itself is kept — the relation is ON DELETE SET NULL.
  streamId    String?
  stream      Stream?       @relation(fields: [streamId], references: [id], onDelete: SetNull)
  channelId   String
  title       String
  description String?
  thumbnail   String?
  // Object-storage key (e.g. "vods/{channelId}/{streamId}/recording.mp4").
  // Never a full URL — the storage provider resolves it to a playable
  // URL/download link, so switching providers never rewrites the DB.
  storageKey  String
  durationSeconds Int       @default(0)
  views       Int           @default(0)
  visibility  VodVisibility @default(PRIVATE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([channelId, createdAt])
  @@index([visibility, createdAt])
  @@index([streamId])
  @@map("vods")
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  follower     User     @relation("FollowerUser", fields: [followerId], references: [id])
  channelId    String
  channel      Channel  @relation("FollowedChannel", fields: [channelId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([followerId, channelId])
  // The compound unique index above is a leftmost-prefix index on
  // `followerId` — great for "who does user X follow" (GET
  // /users/me/following) but useless for "who follows channel Y" (GET
  // /channels/:id/followers), which filters on the *second* column only.
  // This index covers that direction.
  @@index([channelId])
  @@map("follows")
}

// Phase 7 — Social & Discovery: an admin-managed catalog of stream/browse
// categories (e.g. "Just Chatting", "Gaming"). Deliberately NOT a hard FK
// from Channel.category / Stream.category (both remain freeform strings
// from earlier phases) — see docs/domain-model.md §5 for the reasoning.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Simple prefix/equality index for slug lookups and ILIKE-based search on
  // name. A production deployment with a large catalog would likely add a
  // pg_trgm GIN index for fast substring search — noted, not implemented,
  // since it requires a Postgres extension this environment can't verify.
  @@index([name])
  @@map("categories")
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}

// Phase 10 — Moderation & Administration. A user-submitted report about a
// piece of content or account, triaged by MODERATOR/ADMIN via the admin
// API. The target is referenced by (targetType, targetId) without a hard
// FK so reports survive deletion of the reported thing (an audit trail of
// "this was reported" must not vanish when the offending row does).
enum ReportTargetType {
  USER
  CHANNEL
  STREAM
  VOD
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id            String           @id @default(cuid())
  reporterId    String
  reporter      User             @relation("SubmittedReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType    ReportTargetType
  targetId      String
  reason        ReportReason
  description   String?
  status        ReportStatus     @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  resolutionNote String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

// Phase 10 — immutable audit trail of every administrative action. Rows are
// only ever INSERTed (no update/delete API exists), and reads are
// ADMIN-only. `actorId` is deliberately a bare string with no FK: the trail
// must survive deletion of the actor account. `targetType`/`targetId`
// mirror the Report pattern so actions on any domain entity are recordable.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
