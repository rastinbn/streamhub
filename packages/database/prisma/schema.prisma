// StreamHub - Initial Prisma schema
// Phase 1: structural foundation only. Relationships and business rules
// (constraints, cascades, indexes beyond the obvious, etc.) will be refined
// in later phases as each domain module is implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  avatar       String?
  bio          String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  channel   Channel?
  follows   Follow[]       @relation("FollowerUser")
  messages  ChatMessage[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  USER
  STREAMER
  MODERATOR
  ADMIN
}

model Channel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  avatar         String?
  banner         String?
  category       String?
  followersCount Int      @default(0)
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  streams      Stream[]
  followers    Follow[]      @relation("FollowedChannel")
  chatMessages ChatMessage[]

  @@index([category])
  @@map("channels")
}

model Stream {
  id            String       @id @default(cuid())
  channelId     String
  channel       Channel      @relation(fields: [channelId], references: [id])
  title         String?
  description   String?
  category      String?
  thumbnail     String?
  // SHA-256 digest of the raw stream key. The raw key is high-entropy
  // (crypto.randomBytes) and returned to the owner exactly once (on
  // creation/rotation); only this deterministic digest is persisted so the
  // MediaMTX publish webhook can look a presented key up in O(1) without
  // ever storing (or being able to reconstruct) the secret itself. Null
  // once revoked — a revoked stream cannot authenticate a publish until
  // rotated again.
  streamKeyHash String?      @unique
  status        StreamStatus @default(OFFLINE)
  startedAt     DateTime?
  endedAt       DateTime?
  // Denormalized live viewer count. Real-time increments/decrements are
  // expected to be driven by presence tracking (Redis) in a later phase;
  // persisted here so it survives and is queryable alongside the rest of
  // the stream's metadata.
  viewerCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([channelId])
  @@index([status])
  @@index([category])
  @@map("streams")
}

enum StreamStatus {
  OFFLINE
  LIVE
  ENDED
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  follower     User     @relation("FollowerUser", fields: [followerId], references: [id])
  channelId    String
  channel      Channel  @relation("FollowedChannel", fields: [channelId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([followerId, channelId])
  @@map("follows")
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}
