// StreamHub - Initial Prisma schema
// Phase 1: structural foundation only. Relationships and business rules
// (constraints, cascades, indexes beyond the obvious, etc.) will be refined
// in later phases as each domain module is implemented.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  avatar       String?
  bio          String?
  role         Role     @default(USER)
  emailVerified Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  channel   Channel?
  follows   Follow[]       @relation("FollowerUser")
  messages  ChatMessage[]
  notifications Notification[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

// Single-use tokens emailed to a user to confirm ownership of their email
// address. Only the SHA-256 digest of the token is stored (mirrors
// Stream.streamKeyHash) so a leaked database dump can't be used to verify
// arbitrary accounts. Rows are consumed (consumedAt set) or left to expire.
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

enum Role {
  USER
  STREAMER
  MODERATOR
  ADMIN
}

model Channel {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  avatar         String?
  banner         String?
  category       String?
  followersCount Int      @default(0)
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  streams      Stream[]
  followers    Follow[]      @relation("FollowedChannel")
  chatMessages ChatMessage[]

  @@index([category])
  @@index([name])
  @@map("channels")
}

model Stream {
  id            String       @id @default(cuid())
  channelId     String
  channel       Channel      @relation(fields: [channelId], references: [id])
  title         String?
  description   String?
  category      String?
  thumbnail     String?
  // SHA-256 digest of the raw stream key. The raw key is high-entropy
  // (crypto.randomBytes) and returned to the owner exactly once (on
  // creation/rotation); only this deterministic digest is persisted so the
  // MediaMTX publish webhook can look a presented key up in O(1) without
  // ever storing (or being able to reconstruct) the secret itself. Null
  // once revoked — a revoked stream cannot authenticate a publish until
  // rotated again.
  streamKeyHash String?      @unique
  status        StreamStatus @default(OFFLINE)
  startedAt     DateTime?
  endedAt       DateTime?
  // Denormalized live viewer count. Real-time increments/decrements are
  // expected to be driven by presence tracking (Redis) in a later phase;
  // persisted here so it survives and is queryable alongside the rest of
  // the stream's metadata.
  viewerCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([channelId])
  @@index([status])
  @@index([category])
  @@index([title])
  @@map("streams")
}

enum StreamStatus {
  OFFLINE
  LIVE
  ENDED
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  follower     User     @relation("FollowerUser", fields: [followerId], references: [id])
  channelId    String
  channel      Channel  @relation("FollowedChannel", fields: [channelId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([followerId, channelId])
  // The compound unique index above is a leftmost-prefix index on
  // `followerId` — great for "who does user X follow" (GET
  // /users/me/following) but useless for "who follows channel Y" (GET
  // /channels/:id/followers), which filters on the *second* column only.
  // This index covers that direction.
  @@index([channelId])
  @@map("follows")
}

// Phase 7 — Social & Discovery: an admin-managed catalog of stream/browse
// categories (e.g. "Just Chatting", "Gaming"). Deliberately NOT a hard FK
// from Channel.category / Stream.category (both remain freeform strings
// from earlier phases) — see docs/domain-model.md §5 for the reasoning.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Simple prefix/equality index for slug lookups and ILIKE-based search on
  // name. A production deployment with a large catalog would likely add a
  // pg_trgm GIN index for fast substring search — noted, not implemented,
  // since it requires a Postgres extension this environment can't verify.
  @@index([name])
  @@map("categories")
}

model ChatMessage {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@map("chat_messages")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@map("notifications")
}
