# ---------------------------------------------------------------------------
# StreamHub - Environment Variables Example
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# ---------- Database ----------
DATABASE_URL="postgresql://streamhub:streamhub@localhost:5432/streamhub?schema=public"

# ---------- Postgres (docker-compose credentials) ----------
POSTGRES_USER="streamhub"
POSTGRES_PASSWORD="streamhub"
POSTGRES_DB="streamhub"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- Auth (placeholders for future phases) ----------
JWT_SECRET="change-me-dev-only"
JWT_REFRESH_SECRET="change-me-dev-only-refresh"

# ---------- Streaming ----------
# Public URL OBS uses to push RTMP streams to MediaMTX
RTMP_URL="rtmp://localhost:1935"
# Public URL the web player uses to consume HLS output
HLS_URL="http://localhost:8888"
# Internal address of the streaming server (used by the API for metadata only,
# never for proxying media)
STREAMING_SERVER_URL="http://localhost:9997"

# ---------- API ----------
API_PORT=4000
API_PREFIX="api"

# ---------- Security ----------
# Comma-separated list of allowed web origins for CORS.
CORS_ORIGIN="http://localhost:3000"

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
